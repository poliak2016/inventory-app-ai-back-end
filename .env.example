########################################
# Application
########################################

# Application environment
# Allowed: development | test | production
NODE_ENV=

# Port on which API will run
APP_PORT=


########################################
# Database (PostgreSQL)
########################################

# Database host
# - local: localhost
# - docker: service name (e.g. db, db_test)
DB_HOST=

# Database port
DB_PORT=

# Database user
DB_USER=

# Database password
DB_PASSWORD=

# Database name
DB_NAME=

# Full database connection string
# Format:
# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=


########################################
# Docker / PostgreSQL container
########################################

# Used only by postgres image in docker-compose
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=


########################################
# Optional / Future
########################################

# Enable SQL query logging (true | false)
DB_LOGGING=

# Enable detailed error logs (true | false)
DEBUG=
