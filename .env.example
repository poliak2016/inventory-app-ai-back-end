

# Application environment (development | test | production)
NODE_ENV=development

# Port where the app listens
APP_PORT=3000

# Full database connection string
# Example: postgres://postgres:password@localhost:5432/inventory_app
DATABASE_URL=

# Logging level (error | warn | info | debug)
LOG_LEVEL=info

# Redis: enable cache (true | false) and URL
REDIS_ENABLE=false
REDIS_URL=

# Rate limiting (optional)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=20

# See .env.dev, .env.test, .env.prod, .env.docker for full examples